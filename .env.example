# ==============================================================================
# Environment Contract Template (2026)
# ==============================================================================
# Copy this file to a root `.env` file for local development (never commit `.env`
# and do not create `.env.local` in this repository). In Vercel, GitHub Actions,
# or Codespaces, configure these keys in Project Settings / Secrets.
# Never put real secrets or production credentials in this template.

# ==============================================================================
# 1. Public / Browser-Safe Configuration (bundled into browser build)
# ==============================================================================
# Required. Canonical public origin of the Next.js deployment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required. Supabase Project URL and public Publishable Key (anon/publishable).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Optional. Search history and snapshot retention TTL in seconds (default 604800 = 7 days).
NEXT_PUBLIC_SEARCH_HISTORY_TTL_SECONDS="604800"

# ==============================================================================
# 2. PostgreSQL / Prisma ORM 7 Database Connection (server-only)
# ==============================================================================
# Primary database connection for Prisma 7 CLI (`prisma migrate *`, `prisma db`)
# and server runtime (`@prisma/adapter-pg`).
# Recommended for Vercel, GitHub Actions, Codespaces, and IPv4 local networks:
# Supabase Session Pooler on port 5432:
#   postgresql://postgres.<project-ref>:<percent-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Note: percent-encode reserved password characters (#, @, ?, /, $) before pasting.
# For Session Pooler on port 5432, `?pgbouncer=true` is not needed.
DATABASE_URL="postgresql://postgres.<project-ref>:<percent-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Optional backup Postgres connection (used automatically with a sanitized
# console warning only if DATABASE_URL is unset, e.g., a direct IPv6 host).
# SUPABASE_DATABASE_URL_CONNECTION_STRING=""

# Optional Prisma CLI/pool connect timeout in seconds (applied in-process when
# DATABASE_URL lacks connect_timeout to reduce transient pooler P1001 timeouts).
PRISMA_CONNECT_TIMEOUT_SECONDS="30"

# Explicit safety gate required before `npm run db:apply` executes migrations
# against the target Postgres database (set `CONFIRM_DB_APPLY="true"` only on
# the command invocation itself; never store true in committed files).
# CONFIRM_DB_APPLY="false"

# ==============================================================================
# 3. Supabase Private Storage (server-only)
# ==============================================================================
# Canonical server-only Supabase secret (`sb_secret_...`) for private Storage
# manifests and workspace document snapshots. Never prefix with NEXT_PUBLIC_.
# Note: legacy `SUPABASE_SERVICE_ROLE_KEY` is retired and intentionally removed.
SUPABASE_SECRET_KEY=""

# ==============================================================================
# 4. Gemini AI Assisted Search & Filter Helper (server-only)
# ==============================================================================
# Optional at build time; required at runtime for `/api/ai/*` and `/ai-search`.
# Powered by `@google/genai`. Without a valid key, AI routes fail closed with
# HTTP 503 (`missing_config`) while non-AI discovery features keep working.
GEMINI_API_KEY=""

# Optional Gemini model override (defaults to `gemini-2.5-flash` on server).
GEMINI_MODEL="gemini-2.5-flash"

# ==============================================================================
# 5. Dailymotion API V1 — Public / Partner Profile (server-only)
# ==============================================================================
# Public API v1 host for anonymous metadata reads.
DAILYMOTION_API_BASE_URL_V1="https://api.dailymotion.com/"

# Partner REST API v1 host (requires valid V1 credentials below).
DAILYMOTION_PARTNER_API_BASE_URL_V1="https://partner.api.dailymotion.com/rest"

# V1 OAuth token endpoint.
DAILYMOTION_OAUTH_TOKEN_URL_V1="https://partner.api.dailymotion.com/oauth/v1/token"

# Optional V1 key/secret from Dailymotion Studio -> Organization -> API keys.
# Leave empty for anonymous public V1 discovery only.
PRIVATE_DAILYMOTION_API_KEY_V1=""
PRIVATE_DAILYMOTION_API_KEY_SECRET_V1=""

# V1 OAuth scope (`userinfo` is least privilege for token mint + public reads).
DAILYMOTION_API_SCOPE_V1="userinfo"

# ==============================================================================
# 6. Dailymotion API V2 — Canonical V2 Profile (server-only)
# ==============================================================================
# Mandatory for V2 discovery routes (`/api/discovery/v2/*`): V2 requires a
# Bearer client_credentials token cached server-side for 30 minutes.
DAILYMOTION_API_BASE_URL_V2="https://api.dailymotion.com/v2"
DAILYMOTION_OAUTH_TOKEN_URL_V2="https://oauth2.dailymotion.com/v2/token"
PRIVATE_DAILYMOTION_API_KEY_V2=""
PRIVATE_DAILYMOTION_API_KEY_SECRET_V2=""
DAILYMOTION_API_SCOPE_V2="bundle.public"

# ==============================================================================
# 7. Discovery Filtering & Token Cache Defaults (server-only)
# ==============================================================================
# Tri-state global default for V1 (`true` | `false` | unset to let API apply
# default safety filtering). V2 routes use explicit `isExplicit` / `isForKids`.
DAILYMOTION_FAMILY_FILTER="true"
DAILYMOTION_LOCALIZATION="detect"

# Optional high-entropy encryption key enabling cross-instance Postgres token
# caching (`ApiVersionTokenCache`). Leave empty for per-instance memory cache.
TOKEN_CACHE_ENCRYPTION_KEY=""
# Seconds before token expiry to proactively refresh (default 60, max 3600).
TOKEN_CACHE_SAFETY_MARGIN_SECONDS="60"

# ==============================================================================
# 8. Admin Authentication & Migration UI Guard (server-only)
# ==============================================================================
# Admin login (`/admin/login`) protecting `/admin/migrations` and status APIs.
ADMIN_DEFAULT_USERNAME="asdy"
ADMIN_EMAIL="asdy@dailymotion.discov.com"
ADMIN_INITIAL_PASSWORD=""
ADMIN_SESSION_SECRET=""
ADMIN_SESSION_TTL_SECONDS="604800"

# ==============================================================================
# 9. Channel Explorer Persistence, Fetch Safety Caps & Retention (server-only)
# ==============================================================================
# Persists analyzed channels, fetch jobs, windows, manifests, and canonical
# video metadata rows via Prisma ORM 7 + PostgreSQL.
ENABLE_MANIFEST_PERSISTENCE="true"

# Deep-fetch safety limits (server remains authoritative over client settings).
MAX_CHANNEL_FETCH_PAGES="200"
MAX_CHANNEL_FETCH_ITEMS="100000"
MAX_CHANNEL_FETCH_TOTAL_PAGES="5000"
MAX_CHANNEL_FETCH_WINDOWS="3000"
MAX_CHANNEL_FETCH_WINDOW_DEPTH="5"
MAX_CHANNEL_FETCH_PAGE_SIZE="100"
CHANNEL_FETCH_DELAY_MS="250"
CHANNEL_FETCH_MIN_DELAY_MS="100"
CHANNEL_FETCH_CONCURRENCY="3"
CHANNEL_FETCH_MAX_CONCURRENCY="5"
CHANNEL_FETCH_DEFAULT_PROFILE="deep-balanced"

# Temporary operational TTLs (hours) for job/manifest cleanup; canonical sources,
# videos, saved titles, and collections are never expired.
CHANNEL_FETCH_JOB_TTL_HOURS="72"
TEMP_MANIFEST_TTL_HOURS="72"

# ==============================================================================
# 10. Cloudflare R2 + Dedicated Worker & AI Context Bounds (2026)
# ==============================================================================
# Server-only URL and HMAC secret for the dedicated `dailymotion-discovery-api`
# Cloudflare Worker bound to the private `dailymotion-discovery-private` R2 bucket.
# Never expose CLOUDFLARE_R2_WORKER_HMAC_SECRET to the browser.
CLOUDFLARE_R2_WORKER_URL=""
CLOUDFLARE_R2_WORKER_HMAC_SECRET=""
CLOUDFLARE_R2_BUCKET_NAME="dailymotion-discovery-private"

# Canonical owner namespace under `dailymotion/persistence/<STORAGE_OWNER_UUID>/...`
STORAGE_OWNER_UUID="admin"

# Bounded Gemini manifest inspection caps (prevents oversized prompts).
AI_MANIFEST_MAX_ITEMS="25"
AI_MANIFEST_MAX_CHARS="9000"

# ==============================================================================
# 11. Deprecated aliases (retained only for legacy Channel Explorer compatibility)
# ==============================================================================
# Canonical V1/V2 variables above always win over these legacy single-client
# names. Retired variables removed from runtime: `SUPABASE_SERVICE_ROLE_KEY`,
# `CRON_SECRET`, `WEBHOOK_SECRET`, `AI_EMBEDDING_MODEL`, `ENABLE_PGVECTOR`.
# DAILYMOTION_API_BASE_URL="https://api.dailymotion.com"
# DAILYMOTION_API_KEY=""
