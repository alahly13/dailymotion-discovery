# Placeholder documentation only. Do not put real secrets in this file.
# Create a root .env.local for local/online terminals, or configure these keys
# in Vercel, GitHub Codespaces, and GitHub Actions secrets.

# ===== Public/browser-safe variables =====
# Required. These are safe to expose because NEXT_PUBLIC_* values are bundled for the browser.
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ===== Server-only required variables =====
# Canonical runtime DB link: DATABASE_URL_CONNECTION_STRING.
# INTENDED USE (operator choice): Supabase Free Tier DIRECT connection over
# IPv6 for local development and migrations:
# postgresql://postgres:<percent-encoded-password>@db.<project-ref>.supabase.co:5432/postgres
# Direct connections are IPv6-only on the Free plan (AAAA record only). The
# machine running the command MUST have working IPv6 egress — verify with
# `npm run db:diagnose` (DNS + TCP + auth layers, sanitized). If IPv6 egress
# is unavailable (many offices/ISPs; check the egressControl layer), use the
# Session Pooler URL below IN THE SAME VARIABLE NAME — no code change needed:
# postgresql://postgres.<project-ref>:<percent-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (copy the exact host from Supabase Dashboard → Connect; the pooler host
# cannot be composed from the region). Pooler usernames differ
# (postgres.<project-ref> vs postgres for direct).
# PRODUCTION (Vercel): IPv6 egress from Vercel functions is NOT verified from
# here. Supabase's official serverless guidance prescribes the shared pooler
# (transaction mode :6543 for serverless). Unless you verify IPv6 egress on
# Vercel yourself, configure the pooler URL in Vercel's
# DATABASE_URL_CONNECTION_STRING and keep direct locally — same variable
# name, per-environment values. Never point a variable at a different
# database/project.
# Percent-encode reserved password characters such as #, @, ?, /, and $ before pasting.
# For the Session Pooler on port 5432, Prisma does not require a pgbouncer query
# parameter. Only add Prisma connection query parameters when official
# Supabase/Prisma troubleshooting for your exact pooler mode calls for them.
DATABASE_URL_CONNECTION_STRING="postgresql://postgres.<project-ref>:<percent-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Deprecated alias: legacy DATABASE_URL is honored as a fallback with a
# sanitized warning; canonical wins when both are set. Removal planned —
# do not configure it on new deployments.
# DATABASE_URL=""

# Optional separate migration/introspection connection, only when the pooler
# cannot do the job. The name alone never proves a direct host is required;
# do not add a second runtime pool without a verified reason.
# DATABASE_URL_DIRECT=""

# Optional: db:status/db:apply apply this Prisma CLI connect timeout in-process
# when DATABASE_URL does not already include connect_timeout. This is not written
# back to DATABASE_URL and helps avoid transient Supabase Session Pooler P1001s.
PRISMA_CONNECT_TIMEOUT_SECONDS="30"

# Server-only. Required to authorize `npm run db:apply` against a real
# database (CONFIRM_DB_APPLY=true). Never set in committed files.
# CONFIRM_DB_APPLY="false"

# Required for AI routes. Server-only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY="your-server-only-gemini-key"

# Optional Gemini model override for server-side AI routes. Server-only.
# Leave unset to use the app's safe default. Never prefix with NEXT_PUBLIC_.
GEMINI_MODEL="gemini-1.5-flash"

# ===== Server-only Supabase secret =====
# Canonical secret for server-side Supabase SDK (private Storage). Typically
# begins with sb_secret_. Server-only: never NEXT_PUBLIC_, never browser.
# Legacy SUPABASE_SERVICE_ROLE_KEY is retired and is NOT a fallback. In
# Vercel, replace the old variable with this one; do not deactivate keys
# until the deploy reads the new name.
SUPABASE_SECRET_KEY=""

# ===== Deprecated server aliases (do not use in new setup) =====
# Kept only for backward compatibility. Canonical vars always win.
# SUPABASE_SERVICE_ROLE_KEY=""
# DAILYMOTION_API_BASE_URL / DAILYMOTION_API_KEY: legacy single-client vars.

# Dailymotion public metadata discovery works without an API key where endpoints allow it.
DAILYMOTION_API_BASE_URL="https://api.dailymotion.com"
DAILYMOTION_API_KEY=""

CRON_SECRET=""
WEBHOOK_SECRET=""

# ===== Feature flags =====
ENABLE_PGVECTOR="false"

# When true, Channel Explorer persists source metadata, fetch jobs, windows,
# page attempts, temporary manifests, manifest items, and canonical video rows
# through Prisma/Supabase. When false, history and resume are runtime-memory
# only and may reset after restart/deploy.
ENABLE_MANIFEST_PERSISTENCE="true"

# ==============================
# Dailymotion API V1 — Public / Legacy Discovery (canonical)
# ==============================
# Server-only. Public metadata endpoints where anonymous access is supported.
# Optional: without v1 credentials, public discovery still works anonymously.
DAILYMOTION_API_BASE_URL_V1="https://api.dailymotion.com/"

# ==============================
# Dailymotion API V1 — Authenticated Legacy / Partner API (canonical)
# ==============================
# Server-only. Partner host operations REQUIRE a token (anonymous → 401).
# Used automatically once v1 credentials are configured; anonymous reads use
# the public host above. The two hosts are never interchangeable.
DAILYMOTION_PARTNER_API_BASE_URL_V1="https://partner.api.dailymotion.com/rest"

# Legacy / Partner OAuth token endpoint. Server-only.
DAILYMOTION_OAUTH_TOKEN_URL_V1="https://partner.api.dailymotion.com/oauth/v1/token"

# Server-only. V1 key + secret from Dailymotion Studio (Owner/Admin) →
# Organization → API keys. Empty = anonymous public discovery only.
PRIVATE_DAILYMOTION_API_KEY_V1=""
PRIVATE_DAILYMOTION_API_KEY_SECRET_V1=""

# Server-only. V1 token endpoint REQUIRES scope (HTTP 422 without).
# Default userinfo is least privilege for discovery (verified sufficient for
# token acquisition + public/partner reads). Management features need
# manage_videos, manage_players, manage_playlists, manage_subtitles, email.
# Docs: https://developers.dailymotion.com/v0/docs/authenticate.md
DAILYMOTION_API_SCOPE_V1="userinfo"

# ==============================
# Dailymotion API v2 (canonical v2 profile)
# ==============================
# Purpose: base URL, token endpoint, credentials, and scope for API v2.
# Mandatory: YES for any v2 page (every v2 read needs a Bearer token minted
# via client_credentials; tokens live 30 minutes, cached server-side).
# Default scope bundle.public = read-only public content (video.read,
# profile.read, playlist.read) — sufficient for all discovery pages.
# Obtain: Dailymotion Studio (Owner/Admin) → Organization → API keys →
# Create API key → Private API key.
# Docs: https://developers.dailymotion.com/docs/authenticate.md
DAILYMOTION_API_BASE_URL_V2="https://api.dailymotion.com/v2"
DAILYMOTION_OAUTH_TOKEN_URL_V2="https://oauth2.dailymotion.com/v2/token"
PRIVATE_DAILYMOTION_API_KEY_V2=""
PRIVATE_DAILYMOTION_API_KEY_SECRET_V2=""
DAILYMOTION_API_SCOPE_V2="bundle.public"

# ==============================
# Legacy search / content filtering (v1 global params)
# ==============================
# DAILYMOTION_FAMILY_FILTER: tri-state, server-only default for v1.
# "true" (safe default) = explicit on. Unset/empty = OMIT the param so the
# API default (filter ON) applies — a missing variable can never disable the
# safety filter. "false" = deliberate opt-out (the UI warns before sending).
# family_filter is v1-only; v2 uses the documented is_explicit filter instead.
DAILYMOTION_FAMILY_FILTER="true"
DAILYMOTION_LOCALIZATION="detect"

# ==============================
# Token cache (server-only)
# ==============================
# TOKEN_CACHE_ENCRYPTION_KEY: optional long random string enabling the
# encrypted Postgres token cache (cross-instance reuse). Without it, tokens
# reuse in-memory per instance only (documented limitation, still correct).
# Rotation: change the value → old rows fail decrypt → treated as misses →
# tokens reacquired automatically. Never commit a real value here.
TOKEN_CACHE_ENCRYPTION_KEY=""
# Seconds before expiry to refresh a cached token (default 60, max 3600).
TOKEN_CACHE_SAFETY_MARGIN_SECONDS="60"

# ==============================
# Deprecated aliases (do not use in new setup)
# ==============================
# DAILYMOTION_API_BASE_URL / DAILYMOTION_API_KEY: kept only for the
# pre-existing legacy Channel Explorer client. Prefer the versioned vars.
# A V1 base URL containing "partner" is honored as the Partner base with a
# one-time server warning — move it to DAILYMOTION_PARTNER_API_BASE_URL_V1.
# Removal plan: warn (current) → remove in a future major cleanup after the
# legacy client migrates to the versioned profile. These aliases can never
# silently override canonical values: explicit canonical vars always win.

# ==============================
# Admin Session
# ==============================
ADMIN_DEFAULT_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=604800

# ===== Fetch safety limits =====
# MAX_CHANNEL_FETCH_PAGES is kept for backward compatibility with the legacy
# one-window Fetch All route. Deep fetch uses MAX_CHANNEL_FETCH_TOTAL_PAGES
# across all date windows.
MAX_CHANNEL_FETCH_PAGES="200"
MAX_CHANNEL_FETCH_ITEMS="100000"
MAX_CHANNEL_FETCH_TOTAL_PAGES="5000"
MAX_CHANNEL_FETCH_WINDOWS="3000"
MAX_CHANNEL_FETCH_WINDOW_DEPTH="5"
MAX_CHANNEL_FETCH_PAGE_SIZE="100"
CHANNEL_FETCH_DELAY_MS="250"
CHANNEL_FETCH_MIN_DELAY_MS="100"
# Independent date-window worker defaults for deep fetch chunks. Pages inside
# one window still run sequentially; max concurrency is code-capped at 5.
CHANNEL_FETCH_CONCURRENCY="3"
CHANNEL_FETCH_MAX_CONCURRENCY="5"
CHANNEL_FETCH_DEFAULT_PROFILE="deep-balanced"

# Temporary operational retention. Temporary manifests and runtime/database
# fetch jobs may expire, but canonical videos, sources, saved videos, and
# collections must not be deleted by temporary cleanup.
CHANNEL_FETCH_JOB_TTL_HOURS="72"
TEMP_MANIFEST_TTL_HOURS="72"

# ===== Future-only AI/semantic search variables =====
AI_EMBEDDING_MODEL=""
