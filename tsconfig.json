{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "ignoreDeprecations": "6.0",
    "types": [
      "node"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".agents",
    ".cursor",
    ".claude",
    ".devin",
    ".continue",
    ".autohand",
    ".bob",
    ".codeartsdoer",
    ".codebuddy",
    ".codemaker",
    ".codestudio",
    ".commandcode",
    ".cortex",
    ".crush",
    ".mux",
    ".qwen",
    ".zcode",
    ".zencoder",
    ".augment",
    ".aider-desk",
    ".codex-screenshots"
  ]
}
