{
  "name": "ai-public-video-discovery-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Manifest-based public video metadata discovery platform with a Dailymotion Channel Explorer MVP.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/app-validate-env.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "supabase:storage:check": "tsx scripts/supabase-storage-check.mjs",
    "supabase:storage:setup": "tsx scripts/supabase-storage-setup.mjs",
    "env:validate": "node scripts/app-validate-env.mjs",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:status": "node scripts/db-status.mjs",
    "db:apply": "node scripts/db-apply.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "node scripts/db-validate-env.mjs",
    "db:create-migration": "prisma migrate dev --create-only"
  },
  "dependencies": {
    "@google/generative-ai": "latest",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-slot": "latest",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "dotenv": "^17.4.2",
    "flexsearch": "^0.8.212",
    "framer-motion": "latest",
    "lucide-react": "latest",
    "next": "^16.2.0",
    "pg": "^8.20.0",
    "prisma": "7.8.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "postcss": "8.5.14"
  }
}
