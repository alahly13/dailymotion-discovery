{
  "name": "ai-public-video-discovery-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Manifest-based public video metadata discovery platform with a Dailymotion Channel Explorer MVP.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/app-validate-env.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:diagnose": "node scripts/db-diagnose-connection.mjs",
    "supabase:storage:check": "tsx scripts/supabase-storage-check.mjs",
    "supabase:storage:setup": "tsx scripts/supabase-storage-setup.mjs",
    "env:validate": "node scripts/app-validate-env.mjs",
    "env:validate:all": "node scripts/validate-all-env.mjs",
    "db:status": "node scripts/db-status.mjs",
    "db:apply": "node scripts/db-apply.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "node scripts/db-validate-env.mjs",
    "db:create-migration": "prisma migrate dev --create-only"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "flexsearch": "^0.8.212",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "postcss": "8.5.14"
  }
}
